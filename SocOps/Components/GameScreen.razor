@using SocOps.Models

<div class="flex flex-col min-h-full bg-cream">
    <!-- Header -->
    <header class="header-cozy flex items-center justify-between p-3">
        <button
            @onclick="OnReset"
            class="text-coffee text-sm px-3 py-1.5 rounded transition-colors"
            style="background: transparent;">
            ← Back
        </button>
        <h1 class="font-display text-espresso" style="font-size: 1.1rem;">Soc Ops</h1>
        <div class="w-16"></div>
    </header>

    <!-- Instructions -->
    <p class="text-center text-coffee text-sm py-2 px-4">
        Tap a square when you find someone who matches it.
    </p>

    <!-- Bingo indicator -->
    @if (HasBingo)
    {
        <div class="bg-gold text-espresso text-center py-2 font-semibold text-sm border-b border-cinnamon">
            ☕ BINGO! You got a line!
        </div>
    }

    <!-- Board -->
    <div class="flex-1 flex items-center justify-center p-3">
        <BingoBoard
            Board="@Board"
            WinningSquareIds="@WinningSquareIds"
            OnSquareClick="@OnSquareClick" />
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
