<div class="fixed inset-0 bg-espresso/70 flex items-center justify-center p-4 z-50">
    <div class="bg-foam rounded-xl p-6 max-w-xs w-full text-center shadow-xl border border-latte animate-[bounce_0.5s_ease-out]">
        <div class="text-5xl mb-4">☕</div>
        <h2 class="font-display text-3xl text-caramel mb-2">BINGO!</h2>
        <p class="text-coffee mb-6">You completed a line!</p>

        <button
            @onclick="OnDismiss"
            class="btn-primary w-full py-3 px-6">
            Keep Playing
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
